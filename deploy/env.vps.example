# Copy to a secure private .env; never commit secrets.
DOMAIN=license.example.com
ACME_EMAIL=operator@example.com
POSTGRES_DB=licenx
POSTGRES_USER=licenx
POSTGRES_PASSWORD=REPLACE_WITH_LONG_UNIQUE_PASSWORD
# URL-encode special characters in the password below.
DATABASE_URL=postgresql://licenx:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/licenx?sslmode=disable
DATABASE_PROVIDER=postgres
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/var/lib/licenx/storage
PORT=3000
NODE_ENV=production
TRUSTED_PROXY_IP=172.30.3.2
# Created by scripts/install-vps.sh; leave blank in this template.
OWNER_SETUP_CODE_SHA256=
