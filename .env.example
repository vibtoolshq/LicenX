TURSO_AUTH_TOKEN=
TURSO_DATABASE_URL=
# Node VPS PostgreSQL: set DATABASE_PROVIDER=postgres and a private database URL.
# Keep libsql (default) for Turso/Cloudflare. Never commit real credentials.
DATABASE_PROVIDER=libsql
DATABASE_URL=
# Example only: postgresql://licenx:YOUR_PASSWORD@postgres:5432/licenx?sslmode=disable
# For external TLS connections use sslmode=require (certificate verification enabled).
APP_URL=
# Storage: keep r2 for Cloudflare; local is supported only by the Node runtime.
STORAGE_PROVIDER=r2
# For VPS set STORAGE_PROVIDER=local and an absolute directory outside public/dist.
LOCAL_STORAGE_PATH=/opt/licenx/data/storage
