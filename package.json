{
  "name": "react-example",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "prebuild": "npm run build:sdk-archive",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server.js && esbuild src/server/fullBackupWorker.ts --bundle --platform=node --format=esm --packages=external --outfile=build/fullBackupWorker.js",
    "build:sdk-archive": "node scripts/buildPythonSdkArchive.mjs",
    "start": "node build/server.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "verify:sdk-archive": "python tests/verify_sdk_archive.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/lib-storage": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@google/genai": "^2.4.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
